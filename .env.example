# Supabase Connection Settings
# Get these values from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Preferred key for browser and server code.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Legacy alias, still read by lib/supabase/{client,server}.ts.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# Optional: Service Role Key for server-side admin operations (keep secret!)
# Get this from Supabase Dashboard: Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Never put a service role or secret key in a NEXT_PUBLIC_ variable.
