# Supabase Connection Settings
# Get these values from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Preferred key for browser and server code.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Legacy alias, still read by lib/supabase/{client,server}.ts.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# There is no authentication and no server-side admin client any more, so no
# secret key is read anywhere. The publishable key is the only credential this
# app holds, and it is sent to the browser by design -- it is not a secret.
#
# Do not add a NEXT_PUBLIC_ prefix to anything you intend to keep server-side.
