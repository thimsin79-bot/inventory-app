# Supabase Connection Settings
# Get these values from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Preferred key for browser and server code.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Legacy alias, still read by lib/supabase/{client,server}.ts.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# Server-side credential for the Admin Console (/admin/users). The route
# handlers under app/api/admin/ read it, run SQL through the Management API,
# and never expose it to the browser. Create it at
# supabase.com/dashboard/account/tokens with the Database Read-write
# permission. Without it the Users screen still loads and shows an
# actionable error instead of data.
SUPABASE_ACCESS_TOKEN=your-scoped-pat-here

# Shared secret that unlocks the Admin Console API (/api/admin/users*).
# The route handlers refuse every request that does not send it in the
# x-admin-secret header, and the Users screen prompts for it once per tab.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Server-only: no NEXT_PUBLIC_ prefix, or it would ship in the JS bundle.
ADMIN_CONSOLE_SECRET=choose-a-long-random-string

# No NEXT_PUBLIC_ prefix goes on anything server-side. The publishable/anon
# keys above are sent to the browser by design -- they are not secrets.
# The legacy SUPABASE_SERVICE_ROLE_KEY in old .env.local files is stale;
# this app does not read it.
