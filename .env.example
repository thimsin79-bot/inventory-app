# Supabase Connection Settings
# Get these values from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Preferred key for browser and server code.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Legacy alias, still read by lib/supabase/{client,server}.ts.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# Required for the admin password reset at /admin/users. Server-only: this key
# bypasses row level security, so it is never exposed to the browser and is read
# only after an admin role check. The current Supabase equivalent is an
# `sb_secret_...` key (Project Settings -> API -> Secret keys).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Never put a service role or secret key in a NEXT_PUBLIC_ variable.
#
# Accounts are username + password only. There is no email address and nothing is
# emailed, so "Confirm email" must be OFF in the Supabase project or new accounts
# can never sign in.
